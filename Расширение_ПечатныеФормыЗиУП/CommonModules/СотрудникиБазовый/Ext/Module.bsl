
&После("Печать")
Процедура ЛаРС_Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_СправкаВОтделСоцзащиты") Тогда
		ПечатьСправкиВОтделСоцзащиты(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_СправкаВОтделСубсидии") Тогда
		ПечатьСправкиВОтделСубсидии(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПечатнаяФормаСправкиВОтделСоцзащиты(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПФ_MXL_СправкаВОтделСоцзащиты";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.Сотрудники.ПФ_MXL_СправкаВОтделСоцзащиты");
	
	
	МассивОбластейМакета = Новый Массив;
	МассивОбластейМакета.Добавить("Заголовок");
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	ОргКИ.Представление КАК Представление
	|ПОМЕСТИТЬ Адрес
	|ИЗ
	|	Справочник.Организации.КонтактнаяИнформация КАК ОргКИ
	|ГДЕ
	|	ОргКИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресОрганизации)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Организации.НаименованиеПолное КАК СТРОКА(300)) КАК Наименование,
	|	"" Адрес: "" + (ВЫРАЗИТЬ(Адрес.Представление КАК СТРОКА(1000))) КАК Адрес,
	|	"" ИНН "" + (ВЫРАЗИТЬ(Организации.ИНН КАК СТРОКА(10))) КАК ИНН,
	|	&ДатаВыдачи КАК ДатаВыдачи,
	|	КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность,
	|	ВЫРАЗИТЬ(КадроваяИсторияСотрудниковСрезПоследних.Период КАК ДАТА) КАК ДатаС,
	|	Организации.НаименованиеСокращенное КАК Организация,
	|	КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник
	|ИЗ
	|	Адрес КАК Адрес,
	|	РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудниковСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО КадроваяИсторияСотрудниковСрезПоследних.Организация = Организации.Ссылка
	|ГДЕ
	|	КадроваяИсторияСотрудниковСрезПоследних.Сотрудник В(&Сотрудник)
	|	И КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Прием)";
	Запрос.УстановитьПараметр("ДатаВыдачи", Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy"));
	Запрос.УстановитьПараметр("Сотрудник", МассивОбъектов);
	ПараметрыМакета = Запрос.Выполнить().Выбрать();
	ПараметрыМакета.Следующий();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Начисления.ПериодРегистрации КАК ПериодРегистрации,
	|	СУММА(Начисления.Результат) КАК Результат,
	|	Начисления.ФизическоеЛицо КАК ФизическоеЛицо
	|ПОМЕСТИТЬ Начислено
	|ИЗ
	|	РегистрРасчета.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.ФизическоеЛицо = &ФизическоеЛицо
	|	И Начисления.ПериодРегистрации МЕЖДУ ДОБАВИТЬКДАТЕ(&ТекДата, МЕСЯЦ, -12) И &ТекДата
	|
	|СГРУППИРОВАТЬ ПО
	|	Начисления.ПериодРегистрации,
	|	Начисления.ФизическоеЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Удержания.ПериодРегистрации КАК ПериодРегистрации,
	|	СУММА(Удержания.Результат) КАК Результат,
	|	Удержания.ФизическоеЛицо КАК ФизическоеЛицо
	|ПОМЕСТИТЬ Удержано
	|ИЗ
	|	РегистрРасчета.Удержания КАК Удержания
	|ГДЕ
	|	Удержания.ФизическоеЛицо = &ФизическоеЛицо
	|	И Удержания.ПериодРегистрации МЕЖДУ ДОБАВИТЬКДАТЕ(&ТекДата, МЕСЯЦ, -12) И &ТекДата
	|
	|СГРУППИРОВАТЬ ПО
	|	Удержания.ПериодРегистрации,
	|	Удержания.ФизическоеЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтражениеВБухучетеНачисленныйНДФЛОбороты.Период КАК Период,
	|	ОтражениеВБухучетеНачисленныйНДФЛОбороты.ФизическоеЛицо КАК ФизическоеЛицо,
	|	СУММА(ОтражениеВБухучетеНачисленныйНДФЛОбороты.СуммаОборот) КАК СуммаОборот
	|ПОМЕСТИТЬ НДФЛ
	|ИЗ
	|	РегистрНакопления.ОтражениеВБухучетеНачисленныйНДФЛ.Обороты(, , Месяц, ФизическоеЛицо = &ФизическоеЛицо) КАК ОтражениеВБухучетеНачисленныйНДФЛОбороты
	|ГДЕ
	|	ОтражениеВБухучетеНачисленныйНДФЛОбороты.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ТекДата, МЕСЯЦ, -12) И &ТекДата
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтражениеВБухучетеНачисленныйНДФЛОбороты.Период,
	|	ОтражениеВБухучетеНачисленныйНДФЛОбороты.ФизическоеЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Начислено.ПериодРегистрации КАК ДАТА) КАК Период,
	|	Начислено.Результат КАК Начислено,
	|	Удержано.ПериодРегистрации КАК ПериодРегистрации1,
	|	Удержано.Результат КАК Удержано,
	|	НДФЛ.Период КАК ПериодНДФЛ,
	|	НДФЛ.СуммаОборот КАК НДФЛ,
	|	Начислено.ФизическоеЛицо КАК ФизЛицо
	|ИЗ
	|	Начислено КАК Начислено
	|		ЛЕВОЕ СОЕДИНЕНИЕ Удержано КАК Удержано
	|		ПО Начислено.ПериодРегистрации = Удержано.ПериодРегистрации
	|			И Начислено.ФизическоеЛицо = Удержано.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ НДФЛ КАК НДФЛ
	|		ПО Начислено.ПериодРегистрации = НДФЛ.Период
	|			И Начислено.ФизическоеЛицо = НДФЛ.ФизическоеЛицо";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", МассивОбъектов[0].ФизическоеЛицо);
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	ТЗ = Результат.Выгрузить();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.Заполнить(ПараметрыМакета);
	ОбластьМакета.Параметры.ДатаС = Формат(ПараметрыМакета.ДатаС,"ДФ=dd.MM.yyyy");
	ТабличныйДокумент.Вывести(ОбластьМакета);
	ОбластьМакета = Макет.ПолучитьОбласть("Строка");
	
	Пока Выборка.Следующий() Цикл
		
		ОбластьМакета.Параметры.Заполнить(Выборка);
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
	КонецЦикла;
	
	ТЗ.Свернуть("ФизЛицо","Начислено,НДФЛ,Удержано");
	ОбластьМакета = Макет.ПолучитьОбласть("Итого");
	ОбластьМакета.Параметры.Заполнить(ТЗ[0]);
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СведенияОбОтветственныхЛицахСрезПоследних.Руководитель КАК Руководитель,
	|	СведенияОбОтветственныхЛицахСрезПоследних.ГлавныйБухгалтер КАК ГлБух
	|ИЗ
	|	РегистрСведений.СведенияОбОтветственныхЛицах.СрезПоследних(, Организация = &Организация) КАК СведенияОбОтветственныхЛицахСрезПоследних";
	Запрос.УстановитьПараметр("Организация", МассивОбъектов[0].ГоловнаяОрганизация);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	
	ПолноеИмя = Результат.Руководитель;
	// Сначала разбиваем строку на части (Фамилия, Имя, Отчество)
	ЧастиИмени = ФизическиеЛицаКлиентСервер.ЧастиИмени(ПолноеИмя);
	// Формируем фамилию с инициалами
	ОбластьМакета.Параметры.Руководитель = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧастиИмени);
	
	ПолноеИмя = Результат.ГлБух;
	// Сначала разбиваем строку на части (Фамилия, Имя, Отчество)
	ЧастиИмени = ФизическиеЛицаКлиентСервер.ЧастиИмени(ПолноеИмя);
	// Формируем фамилию с инициалами
	ОбластьМакета.Параметры.ГлБух = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧастиИмени);
	
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	
	
	Возврат ТабличныйДокумент;
	
КонецФункции


