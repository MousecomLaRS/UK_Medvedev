	Пока Выборка.Следующий() Цикл
		
		ОбластьМакета.Параметры.Заполнить(Выборка);
		ОбластьМакета.Параметры.Период = Формат(Выборка.Период,"ДФ=MM.yyyy");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
	КонецЦикла;
	
	ТЗ.Свернуть("ФизЛицо","Начислено,НДФЛ,Удержано");
	ОбластьМакета = Макет.ПолучитьОбласть("Итого");
	ОбластьМакета.Параметры.Заполнить(ТЗ[0]);
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СведенияОбОтветственныхЛицахСрезПоследних.Руководитель КАК Руководитель,
	|	СведенияОбОтветственныхЛицахСрезПоследних.ГлавныйБухгалтер КАК ГлБух
	|ИЗ
	|	РегистрСведений.СведенияОбОтветственныхЛицах.СрезПоследних(, Организация = &Организация) КАК СведенияОбОтветственныхЛицахСрезПоследних";
	Запрос.УстановитьПараметр("Организация", МассивОбъектов[0].ГоловнаяОрганизация);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	
	ПолноеИмя = Результат.Руководитель;
	// Сначала разбиваем строку на части (Фамилия, Имя, Отчество)
	ЧастиИмени = ФизическиеЛицаКлиентСервер.ЧастиИмени(ПолноеИмя);
	// Формируем фамилию с инициалами
	ОбластьМакета.Параметры.Руководитель = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧастиИмени);
	
	ПолноеИмя = Результат.ГлБух;
	// Сначала разбиваем строку на части (Фамилия, Имя, Отчество)
	ЧастиИмени = ФизическиеЛицаКлиентСервер.ЧастиИмени(ПолноеИмя);
	// Формируем фамилию с инициалами
	ОбластьМакета.Параметры.ГлБух = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧастиИмени);
	
	ОбластьМакета.Параметры.ДатаВыдачи = Формат(ТекущаяДата(),"ДЛФ=DD");
	
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	
	
	Возврат ТабличныйДокумент;
	
КонецФункции




